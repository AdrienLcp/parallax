{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "ignorePaths": [
    "dist",
    "node_modules",
    "pnpm-lock.yaml",
    "**/worker-configuration.d.ts"
  ],
  "import": ["@cspell/dict-fr-fr/cspell-ext.json"],
  "language": "en,en-GB",
  "overrides": [
    {
      "filename": "**/i18n/dictionary-fr.ts",
      "language": "en,en-GB,fr"
    }
  ],
  "version": "0.2",
  "words": [
    "ABCDEFGHJKLMNPQRTUVWXY",
    "adrienlcp",
    "biomejs",
    "bistrot",
    "bitwarden",
    "BITWARDENCLI",
    "CNIL",
    "dasharray",
    "dashoffset",
    "esbuild",
    "focusables",
    "Foncer",
    "fract",
    "Hololuminescent",
    "Lacourpaille",
    "LCEN",
    "lightfield",
    "lookingglass",
    "minmax",
    "nointeraction",
    "oklab",
    "oklch",
    "overscroll",
    "partysocket",
    "RGPD",
    "subp",
    "webxr",
    "workerd"
  ]
}
