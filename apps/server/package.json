{
  "dependencies": {
    "@adrienlcp/result": "^0.1.1",
    "@parallax/protocol": "workspace:*",
    "hono": "^4.13.16",
    "nanoid": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "name": "@parallax/server",
  "private": true,
  "scripts": {
    "build": "wrangler types --check && tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "cf-typegen": "wrangler types",
    "deploy": "wrangler deploy",
    "dev": "node -e \"require('node:fs').mkdirSync('.wrangler/dev-assets', { recursive: true })\" && wrangler dev --assets .wrangler/dev-assets",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.1.0"
}
