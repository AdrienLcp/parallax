{
  "$schema": "node_modules/wrangler/config-schema.json",
  "assets": {
    "directory": "../game/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "compatibility_date": "2026-11-05",
  // Offset from 8787 like the app from 5173: other dev servers run on this
  // machine, and Vite proxies `/api` and `/ws` here.
  "dev": {
    "port": 8798
  },
  "durable_objects": {
    "bindings": [{ "class_name": "RoomObject", "name": "ROOMS" }]
  },
  "main": "src/index.ts",
  // The free plan only offers Durable Objects backed by SQLite.
  "migrations": [{ "new_sqlite_classes": ["RoomObject"], "tag": "v1" }],
  "name": "parallax",
  "observability": { "enabled": true },
  // Only a display opens rooms, a few a day: ten a minute from one address is
  // already a script. Namespace ids are account-wide; melee holds the 1000s.
  "ratelimits": [
    {
      "name": "ROOM_CREATION_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  // `wrangler deploy` creates the custom domain and its DNS record. No
  // workers.dev host: the subdomain is the only address anything links to.
  "routes": [{ "custom_domain": true, "pattern": "parallax.adrienlcp.com" }],
  "workers_dev": false
}
